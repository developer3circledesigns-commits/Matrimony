# ─────────────────────────────────────────────────────
# Copy to .env and customise. NEVER commit real secrets.
# On production, prefer host env vars over a web-readable .env.
# ─────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=matrimony
DB_USERNAME=matrimony_user
DB_PASSWORD=change_me_strong_password

# ── Application ───────────────────────────────────────
APP_NAME=Matrimony
# production | local
APP_ENV=production
# MUST be false in production (controls display_errors + API debug payloads)
APP_DEBUG=false
# Canonical site URL (emails, OG tags, password-reset links)
APP_URL=https://your-domain.com
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
# Force Secure session cookies: true | false (empty = auto from HTTPS / X-Forwarded-Proto)
SESSION_SECURE=

# ── Mail / SMTP (REQUIRED for production — do not leave as log) ──
# log = write to app/storage/emails/ only (local/dev)
# smtp = real delivery
MAIL_DRIVER=smtp
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@your-domain.com
MAIL_FROM_NAME=Matrimony

# Contact form + ops alerts
ADMIN_EMAIL=admin@your-domain.com

# ── Payments (Razorpay) ────────────────────────────────
PAYMENT_GATEWAY=razorpay
PAYMENT_CURRENCY=INR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# test | live
RAZORPAY_MODE=live

# ── Ops ───────────────────────────────────────────────
# Long random secret for cron + one-time /migrate.
# Prefer header X-Cron-Key. Rotate after migrations. Set MIGRATE_DISABLED=1 after go-live.
CRON_KEY=
MIGRATE_DISABLED=0
